[package]
name = "spalst"
version = "0.0.1"
categories = ["command-line-utilities", "games"]
keywords = ["game", "tui", "terminal"]
repository = "https://github.com/Stefan-Rankovic/Spalst"
license-file = "LICENSE"
edition = "2024"
description = "TUI menu-based game."

[profile.release]
overflow-checks = true

# The code is either good or it isn't. The absurd number of denies is not accidental.
# Lints that are warn instead of deny are either clearly temporary issues or ones from lints.rust I couldn't bother changing to deny.
[lints.cargo]
# Groups
complexity = { level = "deny", priority = -1 }
nursery = { level = "deny", priority = -2 }
pedantic = { level = "deny", priority = -1 }
perf = { level = "deny", priority = -1 }
style = { level = "deny", priority = -1 }
suspicious = { level = "deny", priority = -1 }
# Restriction
non_snake_case_features = "deny"
non_snake_case_packages = "deny"
[lints.rust]
# Groups
deprecated_safe = { level = "deny", priority = -1 }
future_incompatible = { level = "deny", priority = -1 }
keyword_idents = { level = "deny", priority = -1 }
refining_impl_trait = { level = "deny", priority = -1 }
unused = { level = "deny", priority = -1 }
# Allow by default
absolute_paths_not_starting_with_crate = "deny"
ambiguous_negative_literals = "deny"
closure_returning_async_block = "deny"
elided_lifetimes_in_paths = "deny"
macro_use_extern_crate = "deny"
missing_debug_implementations = "deny"
missing_docs = "warn"
missing_unsafe_on_extern = "deny"
non_ascii_idents = "deny"
redundant_imports = "deny"
redundant_lifetimes = "deny"
single_use_lifetimes = "deny"
unit_bindings = "deny"
unsafe_attr_outside_unsafe = "deny"
unsafe_code = "deny"
unsafe_op_in_unsafe_fn = "deny"
unused_crate_dependencies = "deny"
unused_extern_crates = "deny"
unused_import_braces = "deny"
unused_lifetimes = "deny"
unused_macro_rules = "deny"
unused_qualifications = "deny"
unused_results = "deny"
# Warn by default
const_item_mutation = "deny"
dropping_copy_types = "deny"
dropping_references = "deny"
forgetting_copy_types = "deny"
forgetting_references = "deny"
invalid_nan_comparisons = "deny"
invalid_value = "deny"
irrefutable_let_patterns = "deny"
non_camel_case_types = "deny"
path_statements = "deny"
redundant_semicolons = "deny"
unfulfilled_lint_expectations = "deny"
uninhabited_static = "deny"
unknown_diagnostic_attributes = "deny"
unknown_lints = "deny"
unnecessary_transmutes = "deny"
unreachable_code = "deny"
unreachable_patterns = "deny"
unstable_name_collisions = "deny"
unused_associated_type_bounds = "deny"
unused_comparisons = "deny"
useless_ptr_null_checks = "deny"
while_true = "deny"
[lints.clippy]
# Groups
all = { level = "deny", priority = -1 }
cargo = { level = "deny", priority = -1 }
nursery = { level = "deny", priority = -2 }
pedantic = { level = "deny", priority = -1 }
# Restriction
absolute_paths = "deny"
alloc_instead_of_core = "deny"
allow_attributes = "deny"
allow_attributes_without_reason = "warn"
as_conversions = "deny"
as_pointer_underscore = "deny"
as_underscore = "deny"
cfg_not_test = "deny"
clone_on_ref_ptr = "deny"
create_dir = "deny"
dbg_macro = "warn"
default_numeric_fallback = "deny"
else_if_without_else = "deny"
empty_enum_variants_with_brackets = "deny"
empty_structs_with_brackets = "deny"
expect_used = "deny"
filetype_is_file = "deny"
float_arithmetic = "deny"
float_cmp_const = "deny"
fn_to_numeric_cast_any = "deny"
get_unwrap = "deny"
if_then_some_else_none = "deny"
impl_trait_in_params = "deny"
infinite_loop = "deny"
integer_division = "deny"
large_include_file = "deny"
let_underscore_untyped = "deny"
map_err_ignore = "deny"
mem_forget = "deny"
min_ident_chars = "deny"
missing_assert_message = "deny"
missing_docs_in_private_items = "warn"
module_name_repetitions = "deny"
mutex_atomic = "deny"
mutex_integer = "deny"
needless_raw_strings = "deny"
non_zero_suggestions = "deny"
pathbuf_init_then_push = "deny"
pattern_type_mismatch = "deny"
precedence_bits = "deny"
print_stderr = "warn"
print_stdout = "deny"
rc_buffer = "deny"
rc_mutex = "deny"
redundant_test_prefix = "deny"
renamed_function_params = "deny"
rest_pat_in_fully_bound_structs = "deny"
return_and_then = "deny"
same_name_method = "deny"
self_named_module_files = "deny"
shadow_same = "deny"
shadow_unrelated = "deny"
single_char_lifetime_names = "deny"
std_instead_of_core = "deny"
string_slice = "deny"
todo = "warn"
try_err = "deny"
undocumented_unsafe_blocks = "deny"
unnecessary_safety_comment = "warn"
unnecessary_safety_doc = "deny"
unnecessary_self_imports = "deny"
unneeded_field_pattern = "deny"
unseparated_literal_suffix = "deny"
unused_result_ok = "deny"
unused_trait_names = "deny"
use_debug = "warn"
verbose_file_reads = "deny"
wildcard_enum_match_arm = "deny"

[dependencies]
bytes = "1.11.0"
chrono = { version = "0.4.42", features = ["serde"] }
clap = { version = "4.5.50", features = ["derive"] }
color-eyre = "0.6.5"
crossterm = { version = "0.29.0", features = ["event-stream"] }
futures = "0.3.31"
lasso = { version = "0.7.3", features = ["serialize"] }
log = "0.4.28"
ratatui = "0.30.0"
reqwest = { version = "0.13.1", features = ["json"] }
ron = "0.12.0"
semver = { version = "1.0.27", features = ["serde"] }
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.145"
simplelog = "0.12.2"
spalstatui = { path = "src/spalstatui" }
strum = "0.27.2"
strum_macros = "0.27.2"
termimad = "0.34.0"
tokio = { version = "1.47.2", features = ["full"] }
